# Application
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# Database
DATABASE_URL="postgresql://ecommerce:ecommerce_password@localhost:5432/ecommerce?schema=public"

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
# Lifetimes used when the client asks to "Keep me signed in"
JWT_REMEMBER_ME_EXPIRATION=30d
JWT_REMEMBER_ME_REFRESH_EXPIRATION=90d

# Encryption
ENCRYPTION_KEY=your-32-character-encryption-key

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# CSRF
CSRF_SECRET=your-csrf-secret-change-in-production

# Payment Provider (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Bakong KHQR Payment
BAKONG_ACCOUNT_ID=your_bakong_account_id
BAKONG_MERCHANT_NAME=Your Store Name
BAKONG_CITY=Phnom Penh
BAKONG_CURRENCY=USD
BAKONG_PAYMENT_TIMEOUT_MINUTES=10
BAKONG_API_URL=https://api.bakong.nbc.gov.kh
BAKONG_API_TOKEN=your_bakong_api_token

# Email (optional - for development use Ethereal or similar)
# The MAIL_* variables take precedence over their SMTP_* counterpart.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="Your Shop"
# Set MAIL_TRANSPORT=json to capture the emails without sending them.
# The SMTP_* aliases are supported as well:
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM

# Email verification (one-time codes)
OTP_LENGTH=6
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# File Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ecommerce-images
S3_REGION=us-east-1
